# Godot 4+ specific ignores
.godot/
/android/

# Cache de Python de las herramientas de tools/ (se regenera sola)
__pycache__/

# Secreto local del puente GodotIQ (NO subir)
.godotiq/bridge_token

# Builds exportadas (se regeneran; no son código fuente)
/sushiBeta/
*.pck
*.wasm
/builds_antiguas/

# Trabajo temporal en la raíz: capturas de verificación, escenas y scripts
# helper de un rato, y material a medio generar. Todo lo de usar y tirar se
# nombra con "_" delante para que caiga aquí y no acabe en un commit por
# error (ya pasó: 28 MB de _gen/ colados en el historial).
/_*

# Sondas de verificacion de la raiz: escenas y scripts "zz_*" que inyectan
# estado y capturan pantallazos, y sus PNG. Se nombran asi para que caigan
# aqui y no acaben en un commit por error (ya paso: siete se colaron).
/zz*
