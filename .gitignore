# Godot 4+ specific ignores
.godot/
/android/

# Cache de Python de las herramientas de tools/ (se regenera sola)
__pycache__/

# Secreto local del puente GodotIQ (NO subir)
.godotiq/bridge_token

# Builds exportadas (se regeneran; no son código fuente)
/sushiBeta/
*.pck
*.wasm
/builds_antiguas/

# Trabajo temporal en la raíz: capturas de verificación, escenas y scripts
# helper de un rato, y material a medio generar. Todo lo de usar y tirar se
# nombra con "_" delante para que caiga aquí y no acabe en un commit por
# error (ya pasó: 28 MB de _gen/ colados en el historial).
/_*

# Sondas de verificacion de la raiz: escenas y scripts "zz_*" que inyectan
# estado y capturan pantallazos, y sus PNG. Se nombran asi para que caigan
# aqui y no acaben en un commit por error (ya paso: siete se colaron).
/zz*

# Librerias de sonido: material de consulta, no assets del juego.
# Ocupan ~265 MB y se irian enteras al .pck si Godot las viera, por eso
# ademas llevan .gdignore. Lo que se use se COPIA a su carpeta ya convertido
# (sounds/pesca, sounds/cocina, sounds/interfaz, sounds/nivel).
#
# "Cozy Craft" son 174 MB de foley de cocina y oficios y "soundly" tomas a
# 96 kHz y 24 bits: son los ORIGINALES de los que sale la cocina del juego, y
# de cada uno viaja solo su .ogg convertido (unos pocos KB). Viven todas en
# sounds/Sin utilizar/, que es la carcasa que las agrupa.
/sounds/Sin utilizar/

# CLAVES DE API (NUNCA al repositorio). La de Meshy la lee tools/meshy.py y
# tambien vive en la configuracion LOCAL de Claude Code (~/.claude.json), que
# esta fuera del proyecto: aqui no se guarda ninguna clave en claro.
/.env.local
/tools/.meshy_key
